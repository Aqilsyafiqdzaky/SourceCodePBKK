<Window x:Class="StudentWPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Registration"
        Height="550"
        Width="1050"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,15">
            <Button Content="Refresh"
                    Width="100"
                    Height="32"
                    DockPanel.Dock="Right"
                    Click="RefreshButton_Click"/>

            <TextBlock Text="Student Registration"
                       FontSize="26"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </DockPanel>


        <Border Grid.Row="1"
        Margin="0,0,0,10"
        Padding="10"
        Background="#F3F4F6"
        CornerRadius="6">

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Total Mahasiswa:"
                   FontWeight="SemiBold"/>

                <TextBlock x:Name="TotalStudentsText"
                   Text="0"
                   Margin="8,0,0,0"/>
            </StackPanel>
        </Border>


        <DataGrid x:Name="StudentDataGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  HorizontalScrollBarVisibility="Auto">

            <DataGrid.Columns>

                <DataGridTextColumn
                    Header="ID"
                    Binding="{Binding StudentId}"
                    Width="60"/>

                <DataGridTextColumn
                    Header="NIM"
                    Binding="{Binding NIM}"
                    Width="110"/>

                <DataGridTextColumn
                    Header="Nama"
                    Binding="{Binding Name}"
                    Width="180"/>

                <DataGridTextColumn
                    Header="Program Studi"
                    Binding="{Binding ProgramName}"
                    Width="180"/>

                <DataGridTextColumn
                    Header="Tanggal Lahir"
                    Binding="{Binding BirthDate, StringFormat={}{0:dd/MM/yyyy}}"
                    Width="120"/>

                <DataGridTextColumn
                    Header="Alamat"
                    Binding="{Binding Address}"
                    Width="180"/>

                <DataGridTextColumn
                    Header="No. Telepon"
                    Binding="{Binding PhoneNumber}"
                    Width="140"/>


                <DataGridTextColumn
                    Header="Dibuat"
                    Binding="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                    Width="160"/>

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
