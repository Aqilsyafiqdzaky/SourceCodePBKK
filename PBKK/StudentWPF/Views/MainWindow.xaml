<Window x:Class="StudentWPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistem Data Mahasiswa"
        Height="650"
        Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========================================= -->
        <!-- JUDUL -->
        <!-- ========================================= -->

        <TextBlock
            Text="SISTEM DATA MAHASISWA"
            FontSize="30"
            FontWeight="Bold"
            HorizontalAlignment="Center"
            Margin="0,0,0,25"/>

        <!-- ========================================= -->
        <!-- FORM INPUT -->
        <!-- ========================================= -->

        <Border
            Grid.Row="1"
            BorderBrush="LightGray"
            BorderThickness="1"
            CornerRadius="8"
            Padding="15"
            Margin="0,0,0,15">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- NRP -->
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="NRP"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Margin="5"/>

                <TextBox
                    Grid.Row="0"
                    Grid.Column="1"
                    Text="{Binding NRP, UpdateSourceTrigger=PropertyChanged}"
                    Height="30"
                    Margin="5"/>

                <!-- Nama -->
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="2"
                    Text="Nama"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Margin="5"/>

                <TextBox
                    Grid.Row="0"
                    Grid.Column="3"
                    Text="{Binding Nama, UpdateSourceTrigger=PropertyChanged}"
                    Height="30"
                    Margin="5"/>

                <!-- Prodi -->
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Text="Program Studi"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Margin="5"/>

                <TextBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Text="{Binding Prodi, UpdateSourceTrigger=PropertyChanged}"
                    Height="30"
                    Margin="5"/>

                <!-- IPK -->
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="2"
                    Text="IPK"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Margin="5"/>

                <TextBox
                    Grid.Row="1"
                    Grid.Column="3"
                    Text="{Binding IPK, UpdateSourceTrigger=PropertyChanged}"
                    Height="30"
                    Margin="5"/>

            </Grid>

        </Border>

        <!-- ========================================= -->
        <!-- TOMBOL -->
        <!-- ========================================= -->

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="0,0,0,15">

            <Button
                Content="Tambah"
                Command="{Binding AddCommand}"
                Width="110"
                Height="35"
                Margin="5"/>

            <Button
                Content="Update"
                Command="{Binding UpdateCommand}"
                Width="110"
                Height="35"
                Margin="5"/>

            <Button
                Content="Hapus"
                Command="{Binding DeleteCommand}"
                Width="110"
                Height="35"
                Margin="5"/>

            <Button
                Content="Clear"
                Command="{Binding ClearCommand}"
                Width="110"
                Height="35"
                Margin="5"/>

        </StackPanel>

        <!-- ========================================= -->
        <!-- AREA DATA -->
        <!-- ========================================= -->

        <Grid Grid.Row="3">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search -->
            <Grid Margin="0,0,0,10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <TextBlock
                    Text="Cari:"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    Margin="5"/>

                <TextBox
                    Grid.Column="1"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                    Height="30"
                    Margin="5"/>

                <Button
                    Grid.Column="2"
                    Content="Cari"
                    Command="{Binding SearchCommand}"
                    Height="30"
                    Margin="5"/>

            </Grid>

            <!-- DataGrid -->
            <DataGrid
                Grid.Row="1"
                ItemsSource="{Binding MahasiswaList}"
                SelectedItem="{Binding SelectedMahasiswa}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserAddRows="False"
                Margin="5">

                <DataGrid.Columns>

                    <DataGridTextColumn
                        Header="NRP"
                        Binding="{Binding NRP}"
                        Width="150"/>

                    <DataGridTextColumn
                        Header="Nama"
                        Binding="{Binding Nama}"
                        Width="*"/>

                    <DataGridTextColumn
                        Header="Program Studi"
                        Binding="{Binding Prodi}"
                        Width="*"/>

                    <DataGridTextColumn
                        Header="IPK"
                        Binding="{Binding IPK, StringFormat={}{0:F2}}"
                        Width="100"/>

                </DataGrid.Columns>

            </DataGrid>

        </Grid>

    </Grid>

</Window>